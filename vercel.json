{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "medellinvibra.co"
        }
      ],
      "destination": "https://www.medellinvibra.co/$1",
      "permanent": true
    },
    {
      "source": "/ig/:campana/evento/:slug",
      "destination": "/evento/:slug?utm_source=instagram&utm_medium=social&utm_campaign=:campana",
      "permanent": false
    },
    {
      "source": "/ig/:campana",
      "destination": "/?utm_source=instagram&utm_medium=social&utm_campaign=:campana",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/unsubscribe",
      "destination": "/api/unsubscribe"
    },
    {
      "source": "/api/r",
      "destination": "/api/r"
    },
    {
      "source": "/evento/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebookcatalog|twitterbot|whatsapp|linkedinbot|telegrambot|slackbot|googlebot|bingbot|applebot|discordbot|pinterest|gptbot|chatgpt-user|google-extended|claudebot|anthropic-ai|perplexitybot|ccbot).*"
        }
      ],
      "destination": "/api/og?slug=:slug"
    },
    {
      "source": "/organizador/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebookcatalog|twitterbot|whatsapp|linkedinbot|telegrambot|slackbot|googlebot|bingbot|applebot|discordbot|pinterest|gptbot|chatgpt-user|google-extended|claudebot|anthropic-ai|perplexitybot|ccbot).*"
        }
      ],
      "destination": "/api/organizador-og?slug=:slug"
    },
    {
      "source": "/categoria/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebookcatalog|twitterbot|whatsapp|linkedinbot|telegrambot|slackbot|googlebot|bingbot|applebot|discordbot|pinterest|gptbot|chatgpt-user|google-extended|claudebot|anthropic-ai|perplexitybot|ccbot).*"
        }
      ],
      "destination": "/api/categoria-og?slug=:slug"
    },
    {
      "source": "/barrio/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebookcatalog|twitterbot|whatsapp|linkedinbot|telegrambot|slackbot|googlebot|bingbot|applebot|discordbot|pinterest|gptbot|chatgpt-user|google-extended|claudebot|anthropic-ai|perplexitybot|ccbot).*"
        }
      ],
      "destination": "/api/barrio-og?slug=:slug"
    },
    {
      "source": "/gratis",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebookcatalog|twitterbot|whatsapp|linkedinbot|telegrambot|slackbot|googlebot|bingbot|applebot|discordbot|pinterest|gptbot|chatgpt-user|google-extended|claudebot|anthropic-ai|perplexitybot|ccbot).*"
        }
      ],
      "destination": "/api/gratis-og"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
